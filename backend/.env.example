# Must match the credentials in the root .env used by docker compose.
DATABASE_URL=postgresql+psycopg://hooplytics:change_me_local_only@localhost:5433/hooplytics
TEST_DATABASE_URL=postgresql+psycopg://hooplytics:change_me_local_only@localhost:5433/hooplytics_test

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of completed seasons to backfill in addition to the current season.
HISTORY_SEASONS=2

# Background sync while the API server is running.
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=30
SYNC_STALE_MINUTES=30
AUTO_BACKFILL=true
UPCOMING_DAYS=14

# Outbound request behaviour toward the data provider.
PROVIDER_MIN_REQUEST_INTERVAL_SECONDS=0.35
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=4

LOG_LEVEL=INFO

# Unabated sportsbook odds (optional — Prop Finder)
UNABATED_API_KEY=
UNABATED_PARTNER_CODE=
UNABATED_API_BASE_URL=https://data.unabated.com
UNABATED_MIN_REQUEST_INTERVAL_SECONDS=5
PROP_ODDS_SYNC_ON_STARTUP=true
PROP_ODDS_SYNC_INTERVAL_MINUTES=15

# ML-powered Recommended page (disabled by default).
ENABLE_ML_RECOMMENDATIONS=false
